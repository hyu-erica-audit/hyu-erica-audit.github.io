rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email in [
          "admin@audit.kr"
        ];
    }

    function hasPublicListLimit() {
      return request.query.limit != null
        && request.query.limit > 0
        && request.query.limit <= 300;
    }

    function canReadPublished() {
      return resource.data.status == "published";
    }

    function canListPublished() {
      return canReadPublished() && hasPublicListLimit();
    }

    function hasValidStatus(data) {
      return !("status" in data) || data.status in ["draft", "published"];
    }

    function isAdminWriteWithFields(fields) {
      return isAdmin()
        && hasValidStatus(request.resource.data)
        && request.resource.data.keys().hasOnly(fields);
    }

    match /notices/{noticeId} {
      allow get: if canReadPublished() || isAdmin();
      allow list: if canListPublished() || isAdmin();
      allow create, update: if isAdminWriteWithFields([
        "type",
        "category",
        "title",
        "author",
        "date",
        "content",
        "contentHtml",
        "status",
        "pinned",
        "legacyId",
        "createdAt",
        "updatedAt",
        "publishedAt"
      ]);
      allow delete: if isAdmin();
    }

    match /faqs/{faqId} {
      allow get: if canReadPublished() || isAdmin();
      allow list: if canListPublished() || isAdmin();
      allow create, update: if isAdminWriteWithFields([
        "question",
        "answerHtml",
        "answer",
        "status",
        "order",
        "createdAt",
        "updatedAt"
      ]);
      allow delete: if isAdmin();
    }

    match /schedules/{scheduleId} {
      allow get: if canReadPublished() || isAdmin();
      allow list: if canListPublished() || isAdmin();
      allow create, update: if isAdminWriteWithFields([
        "title",
        "startDate",
        "endDate",
        "category",
        "color",
        "description",
        "status",
        "createdAt",
        "updatedAt"
      ]);
      allow delete: if isAdmin();
    }

    match /organizationMembers/{memberId} {
      allow get: if canReadPublished() || isAdmin();
      allow list: if canListPublished() || isAdmin();
      allow create, update: if isAdminWriteWithFields([
        "name",
        "role",
        "team",
        "department",
        "bio",
        "order",
        "status",
        "createdAt",
        "updatedAt"
      ]);
      allow delete: if isAdmin();
    }

    match /contributorSections/{sectionId} {
      allow get: if canReadPublished() || isAdmin();
      allow list: if canListPublished() || isAdmin();
      allow create, update: if isAdminWriteWithFields([
        "title",
        "subtitle",
        "order",
        "status",
        "createdAt",
        "updatedAt"
      ]);
      allow delete: if isAdmin();
    }

    match /contributors/{contributorId} {
      allow get: if canReadPublished() || isAdmin();
      allow list: if canListPublished() || isAdmin();
      allow create, update: if isAdminWriteWithFields([
        "sectionId",
        "role",
        "name",
        "dept",
        "description",
        "order",
        "status",
        "createdAt",
        "updatedAt"
      ]);
      allow delete: if isAdmin();
    }

    match /siteContents/{contentId} {
      allow get: if contentId == "greeting" || isAdmin();
      allow list: if false;
      allow create, update: if isAdminWriteWithFields([
        "title",
        "subtitle",
        "bodyHtml",
        "signatureTitle",
        "signatureName",
        "messageHtml",
        "imageUrl",
        "status",
        "createdAt",
        "updatedAt"
      ]);
      allow delete: if isAdmin();
    }

    match /documents/{documentId} {
      allow get: if canReadPublished() || isAdmin();
      allow list: if canListPublished() || isAdmin();
      allow create, update: if isAdminWriteWithFields([
        "type",
        "title",
        "subtitle",
        "description",
        "icon",
        "date",
        "year",
        "category",
        "status",
        "isImportant",
        "fileName",
        "filePath",
        "fileSize",
        "contentType",
        "downloadUrl",
        "createdAt",
        "updatedAt"
      ]);
      allow delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email in [
          "admin@audit.kr"
        ];
    }

    function hasPublicListLimit() {
      return request.query.limit <= 300;
    }

    function canReadPublished() {
      return resource.data.status == "published";
    }

    function canListPublished() {
      return canReadPublished() && hasPublicListLimit();
    }

    match /notices/{noticeId} {
      allow get: if canReadPublished() || isAdmin();
      allow list: if canListPublished() || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /faqs/{faqId} {
      allow get: if canReadPublished() || isAdmin();
      allow list: if canListPublished() || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /schedules/{scheduleId} {
      allow get: if canReadPublished() || isAdmin();
      allow list: if canListPublished() || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /organizationMembers/{memberId} {
      allow get: if canReadPublished() || isAdmin();
      allow list: if canListPublished() || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /contributorSections/{sectionId} {
      allow get: if canReadPublished() || isAdmin();
      allow list: if canListPublished() || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /contributors/{contributorId} {
      allow get: if canReadPublished() || isAdmin();
      allow list: if canListPublished() || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /siteContents/{contentId} {
      allow get: if contentId == "greeting" || isAdmin();
      allow list: if false;
      allow create, update, delete: if isAdmin();
    }

    match /documents/{documentId} {
      allow get: if canReadPublished() || isAdmin();
      allow list: if canListPublished() || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}

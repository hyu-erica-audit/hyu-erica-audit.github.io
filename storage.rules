rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in [
          "admin@audit.kr"
        ];
    }

    function documentPath(documentId) {
      return /databases/(default)/documents/documents/$(documentId);
    }

    function isPublishedDocumentFile(documentId) {
      return firestore.exists(documentPath(documentId))
        && firestore.get(documentPath(documentId)).data.status == "published";
    }

    // Published document files are publicly readable. Draft, deleted, or
    // unpublished document files are admin-only even if the Storage URL is known.
    match /public/{documentType}/{documentId}/{fileName} {
      allow read: if isPublishedDocumentFile(documentId) || isAdmin();
      allow create, update: if isAdmin()
        && request.resource.size < 25 * 1024 * 1024
        && request.resource.contentType.matches('application/pdf|application/msword|application/vnd.openxmlformats-officedocument.wordprocessingml.document');
      allow delete: if isAdmin();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
